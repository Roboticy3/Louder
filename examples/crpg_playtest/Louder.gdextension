[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://Louder/target/debug/liblouder_rust.so"
linux.release.x86_64 =   "res://Louder/target/release/liblouder_rust.so"
windows.debug.x86_64 =   "res://Louder/target/debug/louder_rust.dll"
windows.release.x86_64 = "res://Louder/target/release/louder_rust.dll"
macos.debug =            "res://Louder/target/debug/liblouder_rust.dylib"
macos.release =          "res://Louder/target/release/liblouder_rust.dylib"
macos.debug.arm64 =      "res://Louder/target/debug/liblouder_rust.dylib"
macos.release.arm64 =    "res://Louder/target/release/liblouder_rust.dylib"
