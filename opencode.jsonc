{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "deny",

      "cargo *": "allow",
      "g++ *": "allow",
      "python *": "allow",
      "go *": "allow",
      "node *": "allow",
      "java*": "allow",

      "Get-*": "allow",
      "Set-*": "allow",
      "Select-*": "allow",
      "Foreach-*": "allow",
      "Where-*": "allow",
      "Copy-*": "allow",
      "Out-*": "allow",

      ".*ps1": "allow",
      ".*exe": "allow",

      "*cpp *": "allow",

    },
    "read": {
      "*": "ask",
      "docs/*": "allow",
      "engine/*": "allow",
      "examples/*": "allow",
      "editor/*.gd": "allow",
      "editor/*.tscn": "allow",
      "editor/*.tres": "allow",
      "editor/*.godot": "allow",
      "logs/*": "deny",
    },
    "external_directory": "deny",
  }
}